#!/usr/bin/env ruby
require_relative '../lib/qaxpert'

require 'optparse'


options = {
  type: nil,
  path: nil,
  ai: nil
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: analyze_by_type --type TYPE --path PATH --ai AI_PROVIDER"

  opts.on('-tTYPE', '--type=TYPE', 'Test stack (e.g. cucumber, junit)') do |t|
    options[:type] = t.to_sym
  end

  opts.on('-pPATH', '--path=PATH', 'Path to repository or tests folder') do |p|
    options[:path] = p
  end

  opts.on('-aAI', '--ai=AI', 'AI provider (openai or gemini)') do |a|
    options[:ai] = a.to_sym
  end

  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit
  end
end

begin
  parser.parse!
  missing = [:type, :path, :ai].select { |k| options[k].nil? }
  unless missing.empty?
    puts "Missing required options: #{missing.join(', ')}"
    puts parser
    exit 1
  end
rescue OptionParser::InvalidOption => e
  warn e.message
  puts parser
  exit 1
end

# Prepare output directory
output_dir = File.join('qaxpert_output', options[:type].to_s)
FileUtils.rm_rf(output_dir)
FileUtils.mkdir_p(output_dir)

# Run analysis
analyzer = QAxpert::Core::Analyzer.new(options[:type])
files = analyzer.analyze(
  options[:path],
  output_dir,
  options[:ai]
)

puts "Analysis completed: #{files.count} files processed. Output in: #{output_dir}"